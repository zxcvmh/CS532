# =============================================================================
# CS532 AUTONOMOUS JETBOT — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# 1. NETWORK & WEBSOCKET BRIDGE
ROBOT_IP=192.168.1.16
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WS_URL=ws://192.168.1.16:8000/ws/robot

# 2. HARDWARE SENSORS (JETSON NANO)
# LiDAR D500 DToF UART connection
LIDAR_PORT=/dev/ttyUSB0
LIDAR_BAUDRATE=230400
LIDAR_HEIGHT_CM=16.0

# Camera CSI Sony IMX219 (GStreamer nvarguscamerasrc)
CAMERA_WIDTH=640
CAMERA_HEIGHT=640
CAMERA_FPS=30
CAMERA_FLIP=0

# Motor Controller I2C (PCA9685 / Adafruit MotorHAT)
I2C_BUS=1
MOTOR_I2C_ADDR=0x60
BATTERY_INA219_ADDR=0x41

# 3. AI & PERCEPTION ENGINE (TENSORRT FP16)
ENGINE_PATH=/home/jetbot/yolov8n.engine
ONNX_PATH=yolov8n.onnx
CONFIDENCE_THRESHOLD=0.25
NMS_THRESHOLD=0.45

# 4. PLANNING & SAFETY CONSTRAINTS
MAP_RESOLUTION=0.05
MAP_WIDTH=200
MAP_HEIGHT=200
MAX_LINEAR_SPEED=0.25
MAX_ANGULAR_SPEED=1.0
REFLEX_STOP_DIST=0.20
SOCIAL_BUBBLE_DEFAULT=0.90
DETOUR_LATERAL_OFFSET=0.52
